# Override API base URL for local dev if frontend/API are on different origins.
# When unset, the app uses same-origin `/api` (works on Vercel, not in `vite dev`).
# For local UI dev you can point this to your deployed site, e.g. "https://dlcmstreaming.vercel.app".
VITE_API_BASE_URL=""

# Protect `/api/check-youtube-live` with a shared secret header `x-cron-secret`.
